# Telegram Bot Token (obtenha com @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GitHub Personal Access Token (obtenha em github.com/settings/tokens)
# Este token será usado para acessar GitHub Models API (GPT-4o gratuito)
GITHUB_TOKEN=your_github_token_here

# ID do Grupo/Canal do Telegram onde os anúncios serão postados
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Ambiente de execução
NODE_ENV=development
