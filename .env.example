# Telegram Bot Token (obtenha com @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GitHub Personal Access Token (obtenha em github.com/settings/tokens)
# Este token será usado para acessar GitHub Models API (GPT-4o gratuito)
GITHUB_TOKEN=your_github_token_here

# ID do Grupo/Canal do Telegram onde os anúncios serão postados
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Ambiente de execução
NODE_ENV=development

# Habilitar servidor API HTTP (true/false)
ENABLE_API_SERVER=false
API_PORT=3000

# ========================================
# Configurações de Automação de Navegador
# ========================================

# Credenciais para login na plataforma
AUTOMATION_USERNAME=
AUTOMATION_PASSWORD=

# URL do site onde a automação será executada
AUTOMATION_URL=

# Seletor CSS do botão a ser clicado (ex: #generate-button)
AUTOMATION_BUTTON_SELECTOR=

# Seletor CSS do elemento contendo o link gerado (ex: .result-link)
AUTOMATION_RESULT_SELECTOR=

# Tempo de espera em segundos após ações (padrão: 3)
AUTOMATION_WAIT_SECONDS=3

# Nome do cookie de sessão (opcional)
AUTOMATION_SESSION_COOKIE=
